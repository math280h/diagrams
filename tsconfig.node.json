{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "vite.electron.config.ts",
    "scripts/third-party-licenses.ts",
    "scripts/sbom.ts",
    "scripts/sbom.test.ts",
    "scripts/standalone-player.ts",
    "scripts/release-notes.ts",
    "scripts/release-notes.test.ts",
    "scripts/readme-features.ts",
    "scripts/readme-features.test.ts",
    "scripts/service-worker.ts",
    "scripts/service-worker.test.ts",
    "electron-builder.ts"
  ]
}
