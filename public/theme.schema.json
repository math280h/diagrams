          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-ink": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "hue-fill": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hue-line": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dim-explore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dim-threats": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dim-art": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "window": {
      "description": "The colours of the desktop window: controls and symbols for the window buttons on Windows and Linux, border for the active window border on Windows.",
      "type": "object",
      "properties": {
        "controls": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}$"
        },
        "symbols": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}$"
        }
      }
    }
  },
  "required": ["name", "base"],
  "description": "A colour theme of Diagrams."
}
