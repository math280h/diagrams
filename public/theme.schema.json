          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "panel-active": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "raised": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "line": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "line-dim": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "line-strong": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "minimap-node": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "minimap-mask": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "faint": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "edge": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "edge-strong": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "particle": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "select": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "flow": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "flow-ink": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "ok": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "warn": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-http": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-rpc": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-data": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-messaging": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-text-http": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-text-rpc": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
        "wire-text-data": {
          "type": "string",
          "pattern": "^#[\\da-fA-F]{6}([\\da-fA-F]{2})?$"
        },
