{
  "name": "diagrams",
  "version": "0.1.1",
  "private": true,
  "description": "Animated architecture diagrams and user flows, on the web and as a desktop app that AI agents can edit.",
  "homepage": "https://draw.thias.dev",
  "bugs": {
    "url": "https://github.com/math280h/diagrams/issues"
  },
  "license": "MIT",
  "author": "Mathias V. Nielsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/math280h/diagrams.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "pnpm build && vite build --config vite.electron.config.ts --mode main && vite build --config vite.electron.config.ts --mode preload",
    "desktop:start": "electron .",
    "desktop:package": "pnpm desktop:build && electron-builder --publish never",
    "release:tag": "node scripts/release-tag.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:all": "node scripts/coverage.ts run",
    "e2e": "playwright test --project web",
    "e2e:desktop": "playwright test --project desktop",
    "icons": "node scripts/icons/build.mjs",
    "app-icon": "node scripts/app-icon.mjs",
    "readme-gif": "node scripts/readme-gif.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hpcc-js/wasm-graphviz": "1.30.0",
    "@tanstack/react-router": "^1.170.46",
    "@vitemcp/server": "^1.9.7",
    "@xyflow/react": "12.12.0",
    "@zumer/snapdom": "3.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "d3-interpolate": "^3.0.1",
    "electron-updater": "6.8.11",
    "elkjs": "^0.12.1",
    "hono": "^4.13.14",
    "immer": "^11.2.9",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "mediabunny": "^1.65.0",
    "mermaid": "^12.2.0",
    "modern-gif": "^2.1.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@bcoe/v8-coverage": "^1.0.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-interpolate": "^3.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/istanbul-lib-coverage": "^1.0.2",
    "@vitest/istanbul-lib-report": "^1.0.2",
    "ast-v8-to-istanbul": "^1.0.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^45.2.1",
    "electron-builder": "26.18.1",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "shadcn": "^4.23.0",
    "simple-icons": "16.36.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "desktopName": "diagrams.desktop",
  "productName": "Diagrams"
}
