{
  "name": "diagrams",
  "version": "0.1.1",
  "private": true,
  "description": "Animated architecture diagrams and user flows, on the web and as a desktop app that AI agents can edit.",
  "homepage": "https://draw.thias.dev",
  "bugs": {
    "url": "https://github.com/math280h/diagrams/issues"
  },
  "license": "MIT",
  "author": "Mathias V. Nielsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/math280h/diagrams.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "pnpm build && vite build --config vite.electron.config.ts --mode main && vite build --config vite.electron.config.ts --mode preload",
    "desktop:start": "electron .",
    "desktop:package": "pnpm desktop:build && electron-builder --publish never",
    "release:tag": "node scripts/release-tag.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project web",
    "e2e:desktop": "playwright test --project desktop",
    "icons": "node scripts/icons/build.mjs",
    "app-icon": "node scripts/app-icon.mjs",
    "readme-gif": "node scripts/readme-gif.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hpcc-js/wasm-graphviz": "1.30.0",
    "@tanstack/react-router": "^1.170.44",
    "@vitemcp/server": "^1.9.6",
    "@xyflow/react": "12.12.0",
    "@zumer/snapdom": "3.3.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "d3-interpolate": "^3.0.1",
    "electron-updater": "6.8.10",
    "elkjs": "^0.12.0",
    "hono": "^4.13.13",
    "immer": "^11.1.21",
    "lucide-react": "^1.58.0",
    "mediabunny": "^1.61.6",
    "mermaid": "^12.2.0",
    "modern-gif": "^2.1.0",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-interpolate": "^3.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^45.0.0",
    "electron-builder": "26.17.0",
    "fflate": "^0.8.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "shadcn": "^4.22.0",
    "simple-icons": "16.35.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ],
    "overrides": {
      "minimatch@>=9 <11.0.1": "^11.0.3"
    }
  },
  "desktopName": "diagrams.desktop",
  "productName": "Diagrams"
}
